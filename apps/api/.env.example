# Postgres connection string (required).
# Examples:
#   postgresql://USER:PASSWORD@127.0.0.1:5432/mutopos?sslmode=disable
#   postgres://mutopos:mutopos@localhost:5432/mutopos?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mutopos?sslmode=disable

# HTTP listen address (default :8080)
HTTP_ADDR=:8080

# development | production | …
APP_ENV=development

# Apply embedded SQL migrations on process start (default true)
AUTO_MIGRATE=true

# Session / OTP hashing salt (change in production)
SESSION_SECRET=mutopos-dev-session-secret

# WhatsApp OTP stub: fixed code accepted for login (returned as dev_code in development)
OTP_STUB_CODE=000000

# Optional TTL overrides
# OTP_TTL_MINUTES=10
# SESSION_TTL_HOURS=336
