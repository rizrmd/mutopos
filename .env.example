# Shared local env example (API also reads apps/api/.env).
# Copy to .env and adjust. Do not commit real secrets.

# Postgres — local install or any hosted instance (no Docker required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mutopos?sslmode=disable

# API
HTTP_ADDR=:8080
APP_ENV=development
AUTO_MIGRATE=true
SESSION_SECRET=mutopos-dev-session-secret
OTP_STUB_CODE=000000

# Client (apps/web, LynxJS) — absolute API origin baked into the bundle.
# A Lynx bundle has no page origin, so a relative /api path cannot resolve.
#
# Fural sandbox (remote host — phone is NOT on the same LAN):
#   leave unset; FURAL_SANDBOX_DOMAIN is injected and QR/API use
#   https://$FURAL_SANDBOX_DOMAIN (API proxied via rspeedy :3005 → Go :8080).
#   Optional override: MUTOPOS_PUBLIC_ORIGIN=https://rizky-mutopos.fural.space
#
# Local laptop + phone on the same Wi-Fi:
# MUTOPOS_API_BASE=http://192.168.1.10:8080
#
# Local simulator only:
# MUTOPOS_API_BASE=http://127.0.0.1:8080
